{
  "info": {
    "name": "E-Commerce REST API",
    "description": "Complete production-ready Postman collection for E-Commerce REST API with automated token injection, separate admin and customer authorization, hierarchical multi-level categories sequence, products catalog, and ACID-safe atomic order flows with idempotency keys. Fully runnable top-to-bottom in the Collection Runner with zero manual edits.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "adminEmail",
      "value": "admin@example.com",
      "type": "string"
    },
    {
      "key": "adminPassword",
      "value": "AdminPassword123!",
      "type": "string"
    },
    {
      "key": "customerEmail",
      "value": "customer@example.com",
      "type": "string"
    },
    {
      "key": "customerPassword",
      "value": "CustomerPassword123!",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "customerToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "customerUserId",
      "value": "",
      "type": "string"
    },
    {
      "key": "runTimestamp",
      "value": "",
      "type": "string"
    },
    {
      "key": "rootCategoryId",
      "value": "",
      "type": "string"
    },
    {
      "key": "subCategoryId",
      "value": "",
      "type": "string"
    },
    {
      "key": "leafCategoryId",
      "value": "",
      "type": "string"
    },
    {
      "key": "productId",
      "value": "",
      "type": "string"
    },
    {
      "key": "orderId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. System",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Check database connection and system status (Public)."
          }
        }
      ]
    },
    {
      "name": "2. Auth",
      "item": [
        {
          "name": "Register Customer",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var ts = Date.now();",
                  "var email = 'customer_' + ts + '@example.com';",
                  "pm.collectionVariables.set('customerEmail', email);",
                  "pm.collectionVariables.set('runTimestamp', ts.toString());",
                  "if (pm.environment) {",
                  "    pm.environment.set('customerEmail', email);",
                  "    pm.environment.set('runTimestamp', ts.toString());",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var json = pm.response.json();",
                  "    if (json.data && json.data.token) {",
                  "        pm.collectionVariables.set('customerToken', json.data.token);",
                  "        if (pm.environment) {",
                  "            pm.environment.set('customerToken', json.data.token);",
                  "        }",
                  "        console.log('Customer JWT Token saved to customerToken');",
                  "    }",
                  "    if (json.data && json.data.user && json.data.user.id) {",
                  "        pm.collectionVariables.set('customerUserId', json.data.user.id);",
                  "        if (pm.environment) {",
                  "            pm.environment.set('customerUserId', json.data.user.id);",
                  "        }",
                  "        console.log('Customer User ID saved to customerUserId');",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Jane Customer\",\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"{{customerPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "register"
              ]
            },
            "description": "Register a customer account. Note: Role cannot be set by client (hardcoded to 'customer')."
          }
        },
        {
          "name": "Login Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    if (json.data && json.data.token) {",
                  "        pm.collectionVariables.set('adminToken', json.data.token);",
                  "        if (pm.environment) {",
                  "            pm.environment.set('adminToken', json.data.token);",
                  "        }",
                  "        console.log('Admin JWT Token saved to adminToken variable');",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "description": "Authenticate as Administrator. Automatically stores token in adminToken variable."
          }
        },
        {
          "name": "Login Customer",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    if (json.data && json.data.token) {",
                  "        pm.collectionVariables.set('customerToken', json.data.token);",
                  "        if (pm.environment) {",
                  "            pm.environment.set('customerToken', json.data.token);",
                  "        }",
                  "        console.log('Customer JWT Token saved to customerToken variable');",
                  "    }",
                  "    if (json.data && json.data.user && json.data.user.id) {",
                  "        pm.collectionVariables.set('customerUserId', json.data.user.id);",
                  "        if (pm.environment) {",
                  "            pm.environment.set('customerUserId', json.data.user.id);",
                  "        }",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"{{customerPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "description": "Authenticate as Customer. Automatically stores token in customerToken variable."
          }
        }
      ]
    },
    {
      "name": "3. Admin - Categories",
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{adminToken}}",
            "type": "string"
          }
        ]
      },
      "item": [
        {
          "name": "Step 1: Create Root Category (Level 0)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var json = pm.response.json();",
                  "    if (json.data && json.data._id) {",
                  "        pm.collectionVariables.set('rootCategoryId', json.data._id);",
                  "        if (pm.environment) {",
                  "            pm.environment.set('rootCategoryId', json.data._id);",
                  "        }",
                  "        console.log('rootCategoryId set:', json.data._id);",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Electronics {{runTimestamp}}\",\n  \"slug\": \"electronics-{{runTimestamp}}\",\n  \"description\": \"Electronic devices and computing hardware\",\n  \"parent\": null\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/categories",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "categories"
              ]
            },
            "description": "Creates root level category with parent: null. Ancestors array auto-initialized to empty."
          }
        },
        {
          "name": "Step 2: Create Child Category (Level 1)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var json = pm.response.json();",
                  "    if (json.data && json.data._id) {",
                  "        pm.collectionVariables.set('subCategoryId', json.data._id);",
                  "        if (pm.environment) {",
                  "            pm.environment.set('subCategoryId', json.data._id);",
                  "        }",
                  "        console.log('subCategoryId set:', json.data._id);",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Computers {{runTimestamp}}\",\n  \"slug\": \"computers-{{runTimestamp}}\",\n  \"description\": \"Desktops, laptops, and personal computing\",\n  \"parent\": \"{{rootCategoryId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/categories",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "categories"
              ]
            },
            "description": "Creates child category under Root. Ancestors array auto-populated with [rootCategoryId]."
          }
        },
        {
          "name": "Step 3: Create Leaf Category (Level 2)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var json = pm.response.json();",
                  "    if (json.data && json.data._id) {",
                  "        pm.collectionVariables.set('leafCategoryId', json.data._id);",
                  "        if (pm.environment) {",
                  "            pm.environment.set('leafCategoryId', json.data._id);",
                  "        }",
                  "        console.log('leafCategoryId set:', json.data._id);",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Gaming Laptops {{runTimestamp}}\",\n  \"slug\": \"gaming-laptops-{{runTimestamp}}\",\n  \"description\": \"High performance laptops for gaming\",\n  \"parent\": \"{{subCategoryId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/categories",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "categories"
              ]
            },
            "description": "Creates leaf category at 3rd level. Ancestors array auto-populated with [rootCategoryId, subCategoryId]."
          }
        },
        {
          "name": "Update / Move Category Subtree",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Laptops & Portables {{runTimestamp}}\",\n  \"parent\": \"{{rootCategoryId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/categories/{{leafCategoryId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "categories",
                "{{leafCategoryId}}"
              ]
            },
            "description": "Demonstrates atomic category subtree relocation. Moves category and all descendants in ONE updateMany aggregation pipeline with cycle detection."
          }
        },
        {
          "name": "Delete Category",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/categories/{{leafCategoryId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "categories",
                "{{leafCategoryId}}"
              ]
            },
            "description": "Delete leaf category (guarded: returns 409 if category has children or products)."
          }
        }
      ]
    },
    {
      "name": "4. Admin - Products",
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{adminToken}}",
            "type": "string"
          }
        ]
      },
      "item": [
        {
          "name": "Create Product (Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var json = pm.response.json();",
                  "    if (json.data && json.data._id) {",
                  "        pm.collectionVariables.set('productId', json.data._id);",
                  "        if (pm.environment) {",
                  "            pm.environment.set('productId', json.data._id);",
                  "        }",
                  "        console.log('productId set:', json.data._id);",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Apex Gaming Laptop {{runTimestamp}}\",\n  \"sku\": \"APEX-LAP-{{runTimestamp}}\",\n  \"description\": \"Flagship gaming laptop with RTX 4090, 64GB RAM, and 2TB NVMe SSD\",\n  \"price\": 24999900,\n  \"salePrice\": 22999900,\n  \"stock\": 25,\n  \"category\": \"{{subCategoryId}}\",\n  \"status\": \"active\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "products"
              ]
            },
            "description": "Create a new product. Prices are in integer paise (24999900 = 249,999.00 INR). effectivePrice automatically computed."
          }
        },
        {
          "name": "List Products (Admin, Includes Inactive)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/products?page=1&limit=20&status=active",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "admin",
                "products"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                },
                {
                  "key": "status",
                  "value": "active"
                }
              ]
            },
            "description": "Admin product catalog listing supporting inactive/draft products."
          }
        },
        {
          "name": "Update Product (Admin)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Apex Gaming Laptop Pro {{runTimestamp}}\",\n  \"salePrice\": 21999900\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/products/{{productId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "products",
                "{{productId}}"
              ]
            },
            "description": "Update product details. Automatically recomputes effectivePrice. Note: Stock is excluded from generic update."
          }
        },
        {
          "name": "Adjust Product Stock Atomically (Admin)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"adjustBy\": 15\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/products/{{productId}}/stock",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "products",
                "{{productId}}",
                "stock"
              ]
            },
            "description": "Dedicated inventory adjustment endpoint. Uses guarded $inc to safely modify inventory without race conditions."
          }
        }
      ]
    },
    {
      "name": "5. Customer - Catalog",
      "item": [
        {
          "name": "Get Categories (Flat, Paginated)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/categories?page=1&limit=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "categories"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            },
            "description": "Flat paginated category list with total count and metadata (Public)."
          }
        },
        {
          "name": "Get Category Tree (In-Memory Nested)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/categories/tree",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "categories",
                "tree"
              ]
            },
            "description": "Public hierarchical category tree constructed in O(N) memory via pure buildTree() (Public)."
          }
        },
        {
          "name": "Get Category by ID (Public)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/categories/{{rootCategoryId}}",
