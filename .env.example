# Server Configuration
NODE_ENV=development
PORT=5000
LOG_LEVEL=info

# Database
MONGODB_URI=mongodb://localhost:27017/ecom
MONGO_URI=mongodb://localhost:27017/ecom
USE_TRANSACTIONS=false

# Security & Authentication
# JWT_SECRET: Minimum 32 characters (change before real use)
JWT_SECRET=supersecretlongjwtsecretkeyformanagingusersessionsatleast32chars
JWT_EXPIRES_IN=24h
BCRYPT_SALT_ROUNDS=12
CORS_ORIGIN=http://localhost:3000

# Admin Initial Seed Credentials
ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD: Minimum 8 characters (change before real use)
ADMIN_PASSWORD=AdminPassword123!

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=30
